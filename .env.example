# postgres is primary; auto tries PostgreSQL then explicitly logs SQLite fallback.
# sqlite skips PostgreSQL. postgres fails if unavailable (no silent fallback).
DB_BACKEND=auto
PGHOST=localhost
PGPORT=5432
PGDATABASE=food_prices
PGUSER=postgres
PGPASSWORD=change_me
# Optional exact filename when data/raw contains multiple CSVs.
RAW_FILE=
