model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Risk","Changes","Staples","Coverage","RiskMonthly","ChiliPrice"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table Risk
ref table Changes
ref table Staples
ref table Coverage
ref table RiskMonthly
ref table ChiliPrice

